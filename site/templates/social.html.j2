<!doctype html>
<html lang="en" data-theme="light">
<head>
<meta charset="utf-8">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,600&family=IBM+Plex+Sans:wght@400;500&family=IBM+Plex+Mono:wght@400;500&display=swap">
<style>
/* 1200x630 social preview card, rendered by site/social.py. Light theme only. */
:root { --bg:#f5f4ef; --fg:#1c1f26; --muted:#5d6370; --s1:#2f4ba0; --c0:#c9d1ea; --c2:#8597d0; --c4:#2f4ba0; color-scheme: light; }
* { box-sizing: border-box; margin: 0; }
body { width: 1200px; height: 630px; background: var(--bg); color: var(--fg); font-family: "IBM Plex Sans", sans-serif;
  padding: 44px 56px; display: grid; grid-template-columns: 430px 1fr; gap: 36px; border-top: 10px solid var(--s1); }
h1 { font: 400 46px/1.08 "Newsreader", Georgia, serif; letter-spacing: -.01em; margin-top: 18px; }
p { font: 400 21px/1.4 "Newsreader", Georgia, serif; color: var(--muted); margin-top: 18px; }
.brand { font: 500 14px "IBM Plex Mono", monospace; text-transform: uppercase; letter-spacing: .1em; color: var(--s1); }
.url { position: absolute; bottom: 40px; left: 56px; font: 400 16px "IBM Plex Mono", monospace; color: var(--muted); }
.cap { font: 500 13px "IBM Plex Mono", monospace; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); margin: 26px 0 14px; }
.chart { width: 100%; height: auto; display: block; overflow: visible; }
.chart rect { stroke: var(--bg); stroke-width: 2; } .chart .k0 { fill: var(--c0); } .chart .k1 { fill: var(--c2); } .chart .k2 { fill: var(--c4); }
.chart .lab { font: 400 18px "IBM Plex Sans", sans-serif; fill: var(--fg); } .chart .val { font: 500 16px "IBM Plex Mono", monospace; fill: var(--muted); }
.key { display: flex; gap: 22px; margin-top: 18px; font: 400 15px "IBM Plex Sans", sans-serif; color: var(--muted); }
.key i { display: inline-block; width: 14px; height: 14px; margin-right: 6px; vertical-align: -2px; border: 1px solid var(--fg); }
.note { font: 400 17px/1.4 "Newsreader", Georgia, serif; color: var(--fg); margin-top: 26px; max-width: 60ch; }
</style>
</head>
<body>
<div>
  <div class="brand">AI-Made Materials: Proof Tracker</div>
  <h1>Which materials made with AI and ML are proven, and against what</h1>
  <p>{{ n }} materials graded by evidence and stage, each set beside the best existing material. Every figure linked to its source.</p>
  <div class="url">{{ site_url | replace("https://", "") }}</div>
</div>
<div>
  <div class="cap">Materials by evidence, split by stage</div>
  {{ chart | safe }}
  <div class="key"><span><i style="background:var(--c0)"></i>Lab</span><span><i style="background:var(--c2)"></i>Customer-tested</span><span><i style="background:var(--c4)"></i>Deployed</span></div>
  <div class="note">{{ note }}</div>
</div>
</body>
</html>
